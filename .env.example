# Postgres connection string. Works with any Postgres host: Neon, Supabase,
# Railway, or a local Postgres via Docker.
DATABASE_URL="postgresql://user:password@localhost:5432/ptu_bazar"

# NextAuth — generate with: npx auth secret
AUTH_SECRET=""
# Required if you run on a non-default port locally, or deploy behind a
# reverse proxy / load balancer that isn't Vercel (Railway, Render, your
# own server). Vercel sets this automatically; everywhere else, set it.
AUTH_TRUST_HOST="true"

# App URL (used for absolute links, e.g. in emails later)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

