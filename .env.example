# Postgres connection string (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# NextAuth Secret & Host Configuration
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Public App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Brevo API Key for Transactional Emails (6-digit OTP & Password Reset)
# Get a free key from https://brevo.com (300 emails/day to any recipient)
# If left empty, verification OTPs and reset links will log directly to your server terminal console.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@campuscart.com"

# Vercel Blob Storage Token for Image Uploads
BLOB_READ_WRITE_TOKEN=""
